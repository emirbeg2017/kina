FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY backend/package*.json ./backend/
RUN cd backend && npm ci --omit=dev
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci
COPY frontend/ ./frontend/
RUN cd frontend && VITE_BACKEND_URL='' VITE_PILOT_MODE=true npm run build

COPY backend/analysis/requirements-local.txt ./backend/analysis/requirements-local.txt
RUN python3 -m venv /opt/kinabot-python \
    && /opt/kinabot-python/bin/pip install --no-cache-dir -r backend/analysis/requirements-local.txt
COPY backend/analysis/download_local_model.py ./backend/analysis/download_local_model.py
ENV LOCAL_ANALYSIS_MODEL_PATH=/opt/kinabot-model
RUN /opt/kinabot-python/bin/python backend/analysis/download_local_model.py

COPY backend/server.js backend/localAnalysis.js backend/localRecordings.js backend/localComparisons.js ./backend/
COPY backend/routes/ ./backend/routes/
COPY backend/middleware/ ./backend/middleware/
COPY backend/scripts/import-local-recordings.js backend/scripts/delete-pilot-account.js ./backend/scripts/
COPY backend/analysis/local_pipeline.py ./backend/analysis/local_pipeline.py
COPY aoi_kinabot_app/config.py aoi_kinabot_app/scoring.py aoi_kinabot_app/speech_to_text.py ./aoi_kinabot_app/

ENV NODE_ENV=production LOCAL_AUTH_ONLY=true LOCAL_AUTH_STORAGE=true PILOT_MODE=true \
    PILOT_DATA_DIR=/var/data SERVE_FRONTEND=true \
    LOCAL_ANALYSIS_PYTHON=/opt/kinabot-python/bin/python
EXPOSE 10000
CMD ["node", "backend/server.js"]
